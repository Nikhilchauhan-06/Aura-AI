rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserOrgId() {
      return getUserData().orgId;
    }

    function isOrgAdmin(orgId) {
      return isSignedIn() && getUserOrgId() == orgId && getUserRole() == 'admin';
    }

    function isOrgEditor(orgId) {
      return isSignedIn() && getUserOrgId() == orgId && (getUserRole() == 'admin' || getUserRole() == 'editor');
    }

    function isOrgMember(orgId) {
      return isSignedIn() && getUserOrgId() == orgId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidOrganization(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.createdAt == request.time;
    }

    function isValidDashboard(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.type in ['executive', 'financial', 'sales', 'employee', 'customer'] &&
             data.ownerId == request.auth.uid &&
             isValidId(data.orgId) &&
             data.createdAt == request.time;
    }

    function isValidAnalytics(data) {
      return data.dashboardId is string && isValidId(data.dashboardId) &&
             data.data is string && data.data.size() <= 1000000 && // 1MB limit for raw data JSON
             data.updatedAt == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isOrgAdmin(getUserOrgId()));
      allow create: if isSignedIn() && isOwner(userId) && 
                      incoming().keys().hasAll(['email', 'orgId', 'role']) &&
                      incoming().role in ['admin', 'editor', 'viewer'];
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email'])) ||
                      (isOrgAdmin(existing().orgId) && incoming().diff(existing()).affectedKeys().hasOnly(['role']));
    }

    match /organizations/{orgId} {
      allow get: if isOrgMember(orgId);
      allow create: if isSignedIn();
      allow update: if isOrgAdmin(orgId);
    }

    match /dashboards/{dashboardId} {
      allow get, list: if isOrgMember(resource.data.orgId);
      allow create: if isOrgEditor(incoming().orgId);
      allow update: if isOrgEditor(existing().orgId) && 
                      incoming().orgId == existing().orgId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'layout', 'updatedAt']);
      allow delete: if isOrgAdmin(existing().orgId) || isOwner(existing().ownerId);

      match /analytics/{docId} {
        allow read: if isOrgMember(get(/databases/$(database)/documents/dashboards/$(dashboardId)).data.orgId);
        allow write: if isOrgEditor(get(/databases/$(database)/documents/dashboards/$(dashboardId)).data.orgId) &&
                       isValidAnalytics(incoming());
      }
      
      match /insights/{insightId} {
        allow read: if isOrgMember(get(/databases/$(database)/documents/dashboards/$(dashboardId)).data.orgId);
        allow create: if isOrgEditor(get(/databases/$(database)/documents/dashboards/$(dashboardId)).data.orgId);
      }
    }
  }
}
